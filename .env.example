# ─────────────────────────────────────────────
# Exam Maker — environment variables
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────

# Google Gemini (optional).
# Get a key from https://aistudio.google.com/apikey
# Leave empty to use the built-in offline exam generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server secret used to seal answer keys with AES-256-GCM (min. 16 characters).
# Use a long random value in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXAM_SEAL_SECRET=change-me-to-a-long-random-secret-value
